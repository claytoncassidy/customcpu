# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y0 [get_cells board_top_i/single_step_clock_0/U0/step_pulse_BUFG_inst]
set_property LOC BUFGCTRL_X0Y1 [get_cells board_clk_IBUF_BUFG_inst]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y26 [get_ports board_clk]

# Clock net "board_top_i/single_step_clock_0/U0/step_pulse_BUFG" driven by instance "board_top_i/single_step_clock_0/U0/step_pulse_BUFG_inst" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_board_top_i/single_step_clock_0/U0/step_pulse_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_board_top_i/single_step_clock_0/U0/step_pulse_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="board_top_i/single_step_clock_0/U0/step_pulse_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_board_top_i/single_step_clock_0/U0/step_pulse_BUFG}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup

# Clock net "board_clk_IBUF_BUFG" driven by instance "board_clk_IBUF_BUFG_inst" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_board_clk_IBUF_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_board_clk_IBUF_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="board_clk_IBUF_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_board_clk_IBUF_BUFG}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup
